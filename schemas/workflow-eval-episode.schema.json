{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Athanor workflow eval episode manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "title",
    "description",
    "created_by",
    "source",
    "runtime",
    "artifacts",
    "scorers",
    "sandbox",
    "limits",
    "privacy"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "created_by": {
      "const": "athanor-workflow-episode-packager"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_root", "scenario_files", "scenario_ids"],
      "properties": {
        "scenario_root": {
          "type": "string",
          "minLength": 1
        },
        "scenario_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scenario_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "command", "requires_python", "dependencies"],
      "properties": {
        "runner": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requires_python": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_root", "scenario_schema", "trace_schema"],
      "properties": {
        "scenario_root": {
          "type": "string",
          "minLength": 1
        },
        "scenario_schema": {
          "type": "string",
          "minLength": 1
        },
        "trace_schema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scorers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "deterministic_grader_kinds"],
      "properties": {
        "type": {
          "const": "deterministic"
        },
        "deterministic_grader_kinds": {
          "type": "array",
          "items": {
            "enum": [
              "forbid_event",
              "require_event",
              "require_order",
              "require_reference"
            ]
          }
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_access",
        "setup_commands_executed",
        "read_only_inputs",
        "filesystem_writes"
      ],
      "properties": {
        "network_access": {
          "const": false
        },
        "setup_commands_executed": {
          "const": false
        },
        "read_only_inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "filesystem_writes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds",
        "max_retries",
        "max_parallelism",
        "max_scenarios",
        "max_trace_records"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0
        },
        "max_parallelism": {
          "type": "integer",
          "minimum": 0
        },
        "max_scenarios": {
          "type": "integer",
          "minimum": 0
        },
        "max_trace_records": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_trace_content", "external_upload"],
      "properties": {
        "raw_trace_content": {
          "enum": ["synthetic_fixture", "redacted", "included"]
        },
        "external_upload": {
          "const": false
        }
      }
    }
  }
}
