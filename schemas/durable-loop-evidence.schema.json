{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Athanor durable loop evidence summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eval_status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "eval_status": {
      "type": "string",
      "enum": [
        "fail",
        "missing",
        "not_applicable",
        "pass"
      ]
    },
    "validator_status": {
      "type": ["string", "null"],
      "enum": [
        null,
        "all_valid",
        "completed_with_residuals",
        "invalid_steps_present",
        "not_yet_run"
      ]
    },
    "tier1_passed": {
      "type": ["boolean", "null"]
    },
    "tier2_completion_met": {
      "type": ["boolean", "null"]
    },
    "tier3_user_response": {
      "type": ["string", "null"],
      "enum": [
        null,
        "abort",
        "continue",
        "continue-iterating",
        "revise-scope",
        "yes"
      ]
    },
    "progress_made": {
      "type": ["boolean", "null"]
    },
    "score_target": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "overall_score",
        "min_dimension_score"
      ],
      "properties": {
        "overall_score": {
          "type": "number"
        },
        "min_dimension_score": {
          "type": "number"
        }
      }
    },
    "assessment": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "kind",
        "report_path",
        "overall_score",
        "min_dimension_score",
        "target_met",
        "priority_plan_items",
        "dimensions"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "baseline",
            "delta",
            "final"
          ]
        },
        "report_path": {
          "type": "string",
          "minLength": 1
        },
        "overall_score": {
          "type": "number"
        },
        "min_dimension_score": {
          "type": "number"
        },
        "target_met": {
          "type": "boolean"
        },
        "priority_plan_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dimensions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "score",
              "target_met",
              "regressed"
            ],
            "properties": {
              "score": {
                "type": "number"
              },
              "target": {
                "type": ["number", "null"]
              },
              "floor": {
                "type": ["number", "null"]
              },
              "target_met": {
                "type": "boolean"
              },
              "regressed": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
