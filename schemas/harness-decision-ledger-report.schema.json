{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Athanor Harness Decision Ledger Report",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "ledger_root",
    "summary",
    "decisions",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": ["pass", "fail"]
    },
    "ledger_root": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "required": ["files", "decisions", "errors"],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "decisions": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "date", "status", "change_type"],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "change_type": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message", "path"],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "decision_id": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
