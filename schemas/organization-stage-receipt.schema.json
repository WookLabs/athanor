{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athanor.local/schemas/organization-stage-receipt.schema.json",
  "title": "Athanor Organization Stage Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "work_item_id",
    "stage",
    "owner_office",
    "owner_role",
    "decision",
    "source",
    "summary",
    "created_at",
    "evidence_refs",
    "source_receipts",
    "commands",
    "safety"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "work_item_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "owner_office": {
      "type": "string",
      "minLength": 1
    },
    "owner_role": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": ["completed", "blocked", "skipped", "handoff"]
    },
    "source": {
      "enum": ["lfg", "lfg-goal", "manual", "gate"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_receipts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutates_files_by_default",
        "external_telemetry",
        "auto_runtime_launch",
        "irreversible_actions",
        "requires_explicit_emit",
        "requires_explicit_work_item_update"
      ],
      "properties": {
        "mutates_files_by_default": {
          "const": false
        },
        "external_telemetry": {
          "const": false
        },
        "auto_runtime_launch": {
          "const": false
        },
        "irreversible_actions": {
          "const": 0
        },
        "requires_explicit_emit": {
          "const": true
        },
        "requires_explicit_work_item_update": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_code", "evidence"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": "integer"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
