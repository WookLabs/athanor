{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Athanor workflow eval scenario file",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenarios"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "min_score", "trace", "graders"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "min_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "trace": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "workflow-trace.schema.json"
            }
          },
          "graders": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "kind"],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "forbid_event",
                    "require_event",
                    "require_order",
                    "require_reference"
                  ]
                },
                "match": {
                  "type": "object"
                },
                "before": {
                  "type": "object"
                },
                "after": {
                  "type": "object"
                },
                "reference": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
