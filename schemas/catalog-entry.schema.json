{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athanor.local/schemas/catalog-entry.schema.json",
  "title": "Athanor Catalog Admission Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "url",
    "local_ref",
    "why_included",
    "license",
    "last_reviewed",
    "adoption_status",
    "runtime_surface_delta",
    "sunset_condition",
    "score",
    "cap_reason",
    "evidence_paths",
    "signals"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "official-contract",
        "runtime",
        "catalog",
        "loop-harness",
        "memory-eval",
        "hook-safety",
        "agentops",
        "plugin-skill"
      ]
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "local_ref": {
      "type": "string",
      "pattern": "^ref/"
    },
    "why_included": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "last_reviewed": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "adoption_status": {
      "enum": [
        "adopt",
        "adapt",
        "observe",
        "reject",
        "sunset"
      ]
    },
    "runtime_surface_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifests",
        "skills",
        "agents",
        "commands",
        "hooks",
        "mcp",
        "cap",
        "cap_sources"
      ],
      "properties": {
        "manifests": {
          "type": "integer",
          "minimum": 0
        },
        "skills": {
          "type": "integer",
          "minimum": 0
        },
        "agents": {
          "type": "integer",
          "minimum": 0
        },
        "commands": {
          "type": "integer",
          "minimum": 0
        },
        "hooks": {
          "type": "integer",
          "minimum": 0
        },
        "mcp": {
          "type": "integer",
          "minimum": 0
        },
        "cap": {
          "type": "boolean"
        },
        "cap_sources": {
          "type": "array",
          "items": {
            "enum": [
              "manifests",
              "skills",
              "agents",
              "commands",
              "hooks",
              "mcp"
            ]
          }
        }
      }
    },
    "sunset_condition": {
      "type": "string",
      "minLength": 1
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall",
        "dimensions",
        "cap_dimension"
      ],
      "properties": {
        "overall": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "local_first",
            "surface_discipline",
            "evidence_strength",
            "license_clarity",
            "athanor_fit"
          ],
          "properties": {
            "local_first": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "surface_discipline": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "evidence_strength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "license_clarity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "athanor_fit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "cap_dimension": {
          "enum": [
            "local_first",
            "surface_discipline",
            "evidence_strength",
            "license_clarity",
            "athanor_fit"
          ]
        }
      }
    },
    "cap_reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_count",
        "has_readme",
        "external_risk_keywords"
      ],
      "properties": {
        "file_count": {
          "type": "integer",
          "minimum": 0
        },
        "has_readme": {
          "type": "boolean"
        },
        "external_risk_keywords": {
          "type": "boolean"
        }
      }
    }
  }
}
