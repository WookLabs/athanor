{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wooklabs.github.io/athanor/schemas/package-knowledge-index-report.schema.json",
  "title": "Athanor Package Knowledge Index Report",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "generated_at",
    "profile",
    "summary",
    "index",
    "entry_points",
    "required_refs",
    "links",
    "forbidden_refs",
    "unresolved_links",
    "sections",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "pass",
        "warn",
        "fail"
      ]
    },
    "generated_at": {
      "type": "string"
    },
    "profile": {
      "type": "object",
      "required": [
        "id",
        "description",
        "mutates_files_by_default",
        "external_telemetry"
      ],
      "properties": {
        "id": {
          "const": "package-facing-knowledge-index"
        },
        "description": {
          "type": "string"
        },
        "mutates_files_by_default": {
          "const": false
        },
        "external_telemetry": {
          "const": false
        }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "checks",
        "warnings",
        "failures",
        "required_refs",
        "missing_required_refs",
        "forbidden_refs",
        "unresolved_links",
        "entry_points",
        "irreversible_actions"
      ],
      "properties": {
        "checks": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "failures": {
          "type": "integer",
          "minimum": 0
        },
        "required_refs": {
          "type": "integer",
          "minimum": 0
        },
        "missing_required_refs": {
          "type": "integer",
          "minimum": 0
        },
        "forbidden_refs": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_links": {
          "type": "integer",
          "minimum": 0
        },
        "entry_points": {
          "type": "integer",
          "minimum": 0
        },
        "irreversible_actions": {
          "const": 0
        }
      },
      "additionalProperties": true
    },
    "index": {
      "type": "object",
      "required": [
        "path",
        "line_count",
        "word_count",
        "max_lines",
        "max_words"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line_count": {
          "type": "integer",
          "minimum": 0
        },
        "word_count": {
          "type": "integer",
          "minimum": 0
        },
        "max_lines": {
          "type": "integer",
          "minimum": 1
        },
        "max_words": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "entry_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "exists",
          "links",
          "status"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "exists": {
            "type": "boolean"
          },
          "links": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "pass",
              "fail"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "required_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "path",
          "exists",
          "linked",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "doc",
              "gate"
            ]
          },
          "path": {
            "type": "string"
          },
          "exists": {
            "type": "boolean"
          },
          "linked": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "pass",
              "fail"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target",
          "kind",
          "status"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "local",
              "external",
              "anchor"
            ]
          },
          "path": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "skip"
            ]
          },
          "exists": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "forbidden_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "unresolved_links": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "section",
          "status"
        ],
        "properties": {
          "section": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "warn",
              "fail"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
