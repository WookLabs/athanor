{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://athanor.local/schemas/work-item-stage-report.schema.json",
  "title": "Athanor work-item stage transition report",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "profile",
    "summary",
    "source",
    "allowed_transitions",
    "approval_states",
    "intervention_states",
    "work_items",
    "transitions",
    "checks",
    "errors"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": ["pass", "fail"]
    },
    "generated_at": {
      "type": "string"
    },
    "profile": {
      "type": "object",
      "required": [
        "id",
        "mutates_files_by_default",
        "external_telemetry",
        "irreversible_actions"
      ],
      "properties": {
        "id": {
          "const": "work-item-stage-transition"
        },
        "mutates_files_by_default": {
          "const": false
        },
        "external_telemetry": {
          "const": false
        },
        "auto_runtime_launch": {
          "const": false
        },
        "irreversible_actions": {
          "const": 0
        }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "checks",
        "errors",
        "warnings",
        "items",
        "transitions",
        "irreversible_actions"
      ],
      "properties": {
        "checks": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "integer",
          "minimum": 0
        },
        "transitions": {
          "type": "integer",
          "minimum": 0
        },
        "irreversible_actions": {
          "const": 0
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object"
    },
    "allowed_transitions": {
      "type": "object"
    },
    "approval_states": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "intervention_states": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "work_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/work_item"
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    }
  },
  "$defs": {
    "work_item": {
      "type": "object",
      "required": [
        "id",
        "owner",
        "stage",
        "dependencies",
        "dependency_status",
        "required_evidence",
        "evidence_status",
        "approval_state",
        "intervention_state"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "dependencies": {
          "type": "array"
        },
        "dependency_status": {
          "enum": ["pass", "fail", "unknown"]
        },
        "required_evidence": {
          "type": "array"
        },
        "evidence_status": {
          "enum": ["pass", "fail"]
        },
        "approval_state": {
          "type": "string"
        },
        "intervention_state": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "transition": {
      "type": "object",
      "required": [
        "sequence",
        "work_item_id",
        "from_stage",
        "to_stage",
        "actor",
        "decision",
        "reason",
        "approval_state",
        "intervention_state",
        "evidence_refs"
      ],
      "properties": {
        "sequence": {
          "type": "integer"
        },
        "work_item_id": {
          "type": "string"
        },
        "from_stage": {
          "type": "string"
        },
        "to_stage": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "approval_state": {
          "type": "string"
        },
        "intervention_state": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "check": {
      "type": "object",
      "required": ["id", "status", "message"],
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "enum": ["pass", "fail", "warn"]
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "required": ["code", "message", "path"],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "work_item_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
