{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Athanor workflow trace record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "seq",
    "phase",
    "event_type",
    "actor",
    "status",
    "message"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "enum": ["external", "gate", "hook", "leader", "worker"]
    },
    "status": {
      "type": "string",
      "enum": ["concern", "escalated", "failure", "pass", "skipped", "started"]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "object"
    }
  }
}
