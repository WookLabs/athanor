{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athanor.local/schemas/organization-operating-model-report.schema.json",
  "title": "Athanor Organization Operating Model Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "generated_at",
    "profile",
    "summary",
    "model",
    "safety",
    "offices",
    "stages",
    "command_coverage",
    "promotion_loop",
    "required_refs",
    "checks",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "pass",
        "warn",
        "fail"
      ]
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "mutates_files_by_default",
        "external_telemetry",
        "auto_runtime_launch"
      ],
      "properties": {
        "id": {
          "const": "organization-operating-model"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "mutates_files_by_default": {
          "const": false
        },
        "external_telemetry": {
          "const": false
        },
        "auto_runtime_launch": {
          "const": false
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checks",
        "errors",
        "warnings",
        "stages",
        "offices",
        "commands",
        "missing_command_mappings",
        "required_refs",
        "missing_required_refs",
        "registered_agent_additions",
        "irreversible_actions"
      ],
      "properties": {
        "checks": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "stages": {
          "type": "integer",
          "minimum": 0
        },
        "offices": {
          "type": "integer",
          "minimum": 0
        },
        "commands": {
          "type": "integer",
          "minimum": 0
        },
        "missing_command_mappings": {
          "type": "integer",
          "minimum": 0
        },
        "required_refs": {
          "type": "integer",
          "minimum": 0
        },
        "missing_required_refs": {
          "type": "integer",
          "minimum": 0
        },
        "registered_agent_additions": {
          "const": 0
        },
        "irreversible_actions": {
          "const": 0
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "id",
        "last_reviewed"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "const": "athanor-organization-operating-model"
        },
        "last_reviewed": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutates_files_by_default",
        "external_telemetry",
        "auto_runtime_launch",
        "default_live_listener",
        "registered_agent_additions",
        "irreversible_actions"
      ],
      "properties": {
        "mutates_files_by_default": {
          "const": false
        },
        "external_telemetry": {
          "const": false
        },
        "auto_runtime_launch": {
          "const": false
        },
        "default_live_listener": {
          "const": false
        },
        "registered_agent_additions": {
          "const": 0
        },
        "irreversible_actions": {
          "const": 0
        }
      }
    },
    "offices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/office"
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "command_coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command_coverage"
      }
    },
    "promotion_loop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "states",
        "owner_office"
      ],
      "properties": {
        "states": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "owner_office": {
          "const": "learning-governance"
        }
      }
    },
    "required_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/required_ref"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    }
  },
  "$defs": {
    "office": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "roles",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "title",
        "office",
        "owner_role",
        "entry_criteria",
        "required_artifacts",
        "exit_criteria",
        "escalation_conditions",
        "receipt_required",
        "leader_write_scope",
        "command_mappings",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": [
            "integer",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "office": {
          "type": "string"
        },
        "owner_role": {
          "type": "string"
        },
        "entry_criteria": {
          "$ref": "#/$defs/string_array"
        },
        "required_artifacts": {
          "$ref": "#/$defs/string_array"
        },
        "exit_criteria": {
          "$ref": "#/$defs/string_array"
        },
        "escalation_conditions": {
          "$ref": "#/$defs/string_array"
        },
        "receipt_required": {
          "type": "boolean"
        },
        "leader_write_scope": {
          "enum": [
            "none",
            "infrastructure-only",
            "artifact-only"
          ]
        },
        "command_mappings": {
          "$ref": "#/$defs/string_array"
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        }
      }
    },
    "command_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "stage_id",
        "status"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "stage_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        }
      }
    },
    "required_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "exists",
        "status"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "exists": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "status",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "code",
        "message",
        "path"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "string_array": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
