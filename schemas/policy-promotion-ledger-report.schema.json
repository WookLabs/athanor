{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athanor.local/schemas/policy-promotion-ledger-report.schema.json",
  "title": "Athanor Policy Promotion Ledger Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "generated_at",
    "profile",
    "summary",
    "lifecycle",
    "ledger",
    "state_counts",
    "promotions",
    "checks",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": ["pass", "warn", "fail"]
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "mutates_files_by_default",
        "external_telemetry",
        "auto_runtime_launch"
      ],
      "properties": {
        "id": {
          "const": "policy-promotion-ledger"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "mutates_files_by_default": {
          "const": false
        },
        "external_telemetry": {
          "const": false
        },
        "auto_runtime_launch": {
          "const": false
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checks",
        "errors",
        "warnings",
        "promotions",
        "gate_promotions",
        "retired_promotions",
        "irreversible_actions"
      ],
      "properties": {
        "checks": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "promotions": {
          "type": "integer",
          "minimum": 0
        },
        "gate_promotions": {
          "type": "integer",
          "minimum": 0
        },
        "retired_promotions": {
          "type": "integer",
          "minimum": 0
        },
        "irreversible_actions": {
          "const": 0
        }
      }
    },
    "lifecycle": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "files"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "state_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "promotions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/promotion"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    }
  },
  "$defs": {
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "title",
        "current_state",
        "owner_office",
        "owner_role",
        "created_at",
        "updated_at",
        "source_refs",
        "evidence_refs",
        "acceptance_criteria",
        "rollback_plan",
        "policy_text",
        "gate_refs",
        "test_refs",
        "schema_refs",
        "replacement_refs",
        "retired_reason",
        "state_history",
        "safety",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "current_state": {
          "type": "string"
        },
        "owner_office": {
          "type": "string"
        },
        "owner_role": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref_report"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref_report"
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rollback_plan": {
          "type": "string"
        },
        "policy_text": {
          "type": "string"
        },
        "gate_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref_report"
          }
        },
        "test_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref_report"
          }
        },
        "schema_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref_report"
          }
        },
        "replacement_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref_report"
          }
        },
        "retired_reason": {
          "type": "string"
        },
        "state_history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state_history"
          }
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mutates_files_by_default",
            "external_telemetry",
            "auto_runtime_launch",
            "irreversible_actions"
          ],
          "properties": {
            "mutates_files_by_default": {
              "const": false
            },
            "external_telemetry": {
              "const": false
            },
            "auto_runtime_launch": {
              "const": false
            },
            "irreversible_actions": {
              "const": 0
            }
          }
        },
        "status": {
          "enum": ["pass", "fail"]
        }
      }
    },
    "state_history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "order",
        "status",
        "owner_role",
        "evidence_refs",
        "decided_at"
      ],
      "properties": {
        "state": {
          "type": "string"
        },
        "order": {
          "type": ["integer", "null"]
        },
        "status": {
          "type": "string"
        },
        "owner_role": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref_report"
          }
        },
        "decided_at": {
          "type": "string"
        }
      }
    },
    "ref_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "exists", "status"],
      "properties": {
        "path": {
          "type": "string"
        },
        "exists": {
          "type": "boolean"
        },
        "status": {
          "enum": ["pass", "fail"]
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "status", "message"],
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "enum": ["pass", "warn", "fail"]
        },
        "message": {
          "type": "string"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "message", "path"],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      }
    }
  }
}
