{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wooklabs.github.io/athanor/schemas/hook-catalog.schema.json",
  "title": "Athanor Hook Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "hooks"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "hooks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "event",
          "matcher",
          "command",
          "runtime_default",
          "policy_mode",
          "evidence_level",
          "performance_budget_ms",
          "dependencies",
          "risk",
          "description",
          "source_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "event": {
            "type": "string",
            "enum": [
              "SessionStart",
              "UserPromptSubmit",
              "PreToolUse",
              "PostToolUse",
              "Notification",
              "Stop",
              "SubagentStop",
              "PreCompact",
              "PermissionRequest",
              "PostToolUseFailure",
              "FileChanged"
            ]
          },
          "matcher": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "runtime_default": {
            "type": "string",
            "enum": ["enabled", "disabled", "capture-only"]
          },
          "policy_mode": {
            "type": "string",
            "enum": ["observe", "warn", "strict", "block"]
          },
          "evidence_level": {
            "type": "string",
            "enum": ["none", "synthetic", "live-redacted", "replay-gated"]
          },
          "performance_budget_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "risk": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
